# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# AI Provider API Keys (Optional - fallback to deterministic parsing if omitted)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Master Security Vault Keys
CARRIER_VAULT_MASTER_KEY=your-carrier-vault-master-key-32-chars-minimum
QUOTE_TOKEN_SECRET=your-quote-token-hmac-secret-key

